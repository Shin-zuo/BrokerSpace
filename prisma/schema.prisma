// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Broker
  SuperAdmin
}

enum PropertyStatus {
  Available
  Sold
  Draft
}

enum PropertyType {
  House
  Condominium
  Townhouse
  Land
  Commercial
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  LIKE
  FRIEND_REQUEST
  SYSTEM
}

model User {
  id             String     @id @default(uuid())
  role           Role       @default(Broker)
  username       String     @unique
  email          String     @unique
  password       String
  
  brokerId       String?    @unique @map("broker_id")
  broker         Broker?    @relation(fields: [brokerId], references: [id])
  
  // Relations for new social features
  likes            Like[]          @relation("UserLikes")
  savedProperties  SavedProperty[] @relation("UserSaves")
  conversationsOne Conversation[]  @relation("ParticipantOne")
  conversationsTwo Conversation[]  @relation("ParticipantTwo")
  messagesSent     Message[]       @relation("MessageSender")
  
  connectionsRequested Connection[] @relation("ConnectionRequester")
  connectionsReceived  Connection[] @relation("ConnectionReceiver")
  notifications        Notification[] @relation("UserNotifications")
  notificationsActed   Notification[] @relation("ActorNotifications")

  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

model Broker {
  id                String     @id @default(uuid())
  name              String
  whatsappNumber    String     @map("whatsapp_number")
  contactNumber     String?    @map("contact_number")
  companyName       String?    @map("company_name")
  licenseNumber     String?    @map("license_number")
  bio               String?
  profilePictureUrl String?    @map("profile_picture_url")
  facebookUrl       String?    @map("facebook_url")
  linkedinUrl       String?    @map("linkedin_url")
  officeAddress     String?    @map("office_address")
  instagramUrl      String?    @map("instagram_url")
  websiteUrl        String?    @map("website_url")
  specialization    String?
  publicEmail       String?    @map("public_email")

  user              User?
  properties        Property[]
  
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@map("brokers")
}

model Property {
  id            String          @id @default(uuid())
  brokerId      String          @map("broker_id")
  broker        Broker          @relation(fields: [brokerId], references: [id])
  title         String
  description   String
  price         Decimal
  status        PropertyStatus  @default(Available)
  propertyType  PropertyType    @default(House) @map("property_type")
  sizeSqm       Decimal?        @map("size_sqm")
  region        String
  addressLine1  String          @map("address_line_1")
  city          String
  stateProvince String          @map("state_province")
  postalCode    String          @map("postal_code")
  country       String
  latitude      Decimal?
  longitude     Decimal?
  images        PropertyImage[]
  
  // Relations for new social features
  likes         Like[]
  saves         SavedProperty[]
  conversations Conversation[]
  notifications Notification[]
  
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id])
  url        String
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("property_images")
}

model Like {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation("UserLikes", fields: [userId], references: [id])
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, propertyId])
  @@map("likes")
}

model SavedProperty {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation("UserSaves", fields: [userId], references: [id])
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, propertyId])
  @@map("saved_properties")
}

model Conversation {
  id               String   @id @default(uuid())
  participantOneId String   @map("participant_one_id")
  participantTwoId String   @map("participant_two_id")
  
  participantOne   User     @relation("ParticipantOne", fields: [participantOneId], references: [id])
  participantTwo   User     @relation("ParticipantTwo", fields: [participantTwoId], references: [id])
  
  propertyId       String?  @map("property_id")
  property         Property? @relation(fields: [propertyId], references: [id])
  
  messages         Message[]
  
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([participantOneId, participantTwoId, propertyId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  senderId       String       @map("sender_id")
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  
  content        String
  isRead         Boolean      @default(false) @map("is_read")
  
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("messages")
}

model Connection {
  id          String           @id @default(uuid())
  requesterId String           @map("requester_id")
  receiverId  String           @map("receiver_id")
  
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id])
  receiver    User             @relation("ConnectionReceiver", fields: [receiverId], references: [id])
  
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([requesterId, receiverId])
  @@map("connections")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  user       User             @relation("UserNotifications", fields: [userId], references: [id])
  
  actorId    String?          @map("actor_id")
  actor      User?            @relation("ActorNotifications", fields: [actorId], references: [id])
  
  type       NotificationType
  isRead     Boolean          @default(false) @map("is_read")
  
  propertyId String?          @map("property_id")
  property   Property?        @relation(fields: [propertyId], references: [id])
  
  createdAt  DateTime         @default(now()) @map("created_at")

  @@map("notifications")
}
